#!/usr/bin/env python3
"""Run the dashboard's tests after the foundation checks."""
import os
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[1]
MINIMUM = (3, 12)


def main():
    if sys.version_info < MINIMUM:
        found, minimum = ".".join(map(str, sys.version_info[:3])), ".".join(map(str, MINIMUM))
        print(f"Checks need Python {minimum} or later; this is {found}. Put a newer python3 first on PATH.",
              file=sys.stderr)
        return 1
    env = {key: value for key, value in os.environ.items()
           if not key.startswith(("GIT_", "TD_")) and key not in {"PYTHONPATH", "PYTHONHOME"}}
    env["PYTHONDONTWRITEBYTECODE"] = "1"
    return subprocess.run([sys.executable, "-B", "-m", "unittest", "discover", "-s", "tests"],
                          cwd=ROOT, env=env).returncode


if __name__ == "__main__":
    sys.exit(main())
