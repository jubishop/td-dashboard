#!/bin/sh
# Install or update the td dashboard on its host, then wait for it to report healthy.
# README.md describes the service and its site settings.
set -eu

host=${TD_DASHBOARD_HOST:-raspberry-pi}
url=${TD_DASHBOARD_URL:-http://raspberry-pi.local:8081}
root=$(cd "$(dirname "$0")/.." && pwd)

if ! ssh "$host" test -f /etc/default/td-dashboard; then
  echo "$host has no /etc/default/td-dashboard; create it with the host names to answer, as README.md describes." >&2
  exit 1
fi

remote=$(ssh "$host" mktemp -d)
# Ship the committed app, never local edits or caches.
git -C "$root" archive --format=tar HEAD td_dashboard systemd/td-dashboard.service | ssh "$host" tar -x -C "$remote"
# shellcheck disable=SC2087 # $remote expands locally on purpose.
ssh "$host" sh -eu <<EOF
trap 'rm -rf "$remote"' EXIT
python3 -I -B "$remote/td_dashboard" --help >/dev/null
sudo rm -rf /usr/local/lib/td-dashboard.new /usr/local/lib/td-dashboard.old
sudo cp -R "$remote/td_dashboard" /usr/local/lib/td-dashboard.new
if [ -e /usr/local/lib/td-dashboard ]; then sudo mv /usr/local/lib/td-dashboard /usr/local/lib/td-dashboard.old; fi
sudo mv /usr/local/lib/td-dashboard.new /usr/local/lib/td-dashboard
sudo rm -rf /usr/local/lib/td-dashboard.old
sudo install -m 0644 "$remote/systemd/td-dashboard.service" /etc/systemd/system/td-dashboard.service
sudo systemctl daemon-reload
sudo systemctl enable --quiet td-dashboard.service
sudo systemctl restart td-dashboard.service
EOF

attempt=0
while [ "$attempt" -lt 20 ]; do
  if health=$(curl -fsS -m 5 "$url/healthz" 2>/dev/null); then
    echo "$health"
    echo "td dashboard is healthy at $url"
    exit 0
  fi
  attempt=$((attempt + 1))
  sleep 1
done
echo "td dashboard did not report healthy at $url/healthz" >&2
curl -sS -m 5 "$url/healthz" >&2 || true
ssh "$host" sudo journalctl -u td-dashboard -n 30 --no-pager >&2
exit 1
